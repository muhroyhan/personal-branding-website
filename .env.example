# Public base URL of the deployed site (Vercel project URL or custom domain).
# Used by app/sitemap.ts, app/robots.ts, app/opengraph-image.tsx, and the
# JSON-LD Person schema in app/layout.tsx to build absolute URLs.
# Falls back to http://localhost:3000 if unset (fine for local dev, wrong
# in production — must be set in Vercel).
NEXT_PUBLIC_SITE_URL=https://personal-branding-website.vercel.app

# --- "Tanya tentang Royhan" RAG chatbot (app/api/chat/route.ts) ---
# All three vars below are server-only (no NEXT_PUBLIC_ prefix) — never
# exposed to the client bundle.

# Groq API key for LLM inference (https://console.groq.com/keys).
GROQ_API_KEY=

# Groq model id. Default is the open-weight gpt-oss-20b model.
# Do NOT use llama-3.1-8b-instant or llama-3.3-70b-versatile — both are
# deprecated on Groq as of 2026-08-16.
# Fallback options: openai/gpt-oss-120b (deeper answers), qwen/qwen3.6-27b.
GROQ_MODEL=openai/gpt-oss-20b

# Upstash Redis REST credentials, used for per-IP rate limiting on
# /api/chat (https://console.upstash.com — Redis free tier).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
